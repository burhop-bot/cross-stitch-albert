// flossBrands.ts — Full color database
export interface FlossColor {
  number: string;      // "824"
  name: string;        // "Pine Green"
  hex: string;         // "#3D5337"
  rgb: { r: number; g: number; b: number };
}

export interface FlossBrand {
  id: string;
  name: string;
  colors: FlossColor[];
}

export const FLOSS_BRANDS: Record<string, FlossBrand> = {
  dmc: { id: 'dmc', name: 'DMC', colors: [...] },
  anchor: { id: 'anchor', name: 'Anchor', colors: [...] },
  madeira: { id: 'madeira', name: 'Madeira Mouline', colors: [...] },
};

// Pre-computed cross-reference table
export const CROSS_REF: Record<string, Record<string, string>> = {
  'dmc-824': { anchor: '1182', madeira: 'GL31' },
  // ... 500+ entries
};
```

