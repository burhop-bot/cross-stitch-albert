}

// dithering.ts
export interface DitheringOptions {
  algorithm: 'floyd-steinberg' | 'sierra-3-2-1' | 'none';
  errorDiffusion: boolean;
  threshold: number; // 0-1, for threshold-based dithering
}

export function applyDithering(
  grid: number[][][], // [[r,g,b], ...]
  palette: number[][], // target palette RGB values
  options: DitheringOptions
): number[][] { // quantized grid indices
  // Floyd-Steinberg: diffuses error to 4 neighbors
  // Sierra 3-2-1: lighter diffusion, smoother results
}
```

**Image conversion flow (new):**

```
1. Load image → pixel array (RGBA)
2. Optional: crop blank borders
3. Resize to target stitch count
4. K-Means cluster to N colors
5. Map clusters to DMC colors (Mahalanobis)
6. Optional: apply dithering (FS/Sierra)
7. Post-process: smooth, remove noise
8. Result: color grid + palette
```

**UI additions to ImageConversionPanel:**
- Conversion method selector: "Simple (nearest)" | "K-Means" | "K-Means + Dither"
- Dithering algorithm selector (when applicable)
- K value slider (2-128 colors)
- "Preserve dominant colors" checkbox
- "Smooth after conversion" toggle
- Preview panel showing quantized result
- Before/after comparison slider

**Dependencies:** `kMeans.ts` and `dithering.ts` are pure JS, no external deps needed.

